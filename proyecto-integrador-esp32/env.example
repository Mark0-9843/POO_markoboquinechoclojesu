# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# El archivo .env NO se sube al repositorio (lleva credenciales reales).

# --- Base de datos (los lee docker-compose.yml) ---
POSTGRES_USER=fleettrack
POSTGRES_PASSWORD=fleettrack
POSTGRES_DB=fleettrack

# Con docker compose el host es "db" (nombre del servicio en docker-compose.yml).
# Si corres la API sin Docker, cambia "db" por "localhost".
DATABASE_URL=postgresql://fleettrack:fleettrack@db:5432/fleettrack

# --- Entorno ---
# "development": el backend crea las tablas con create_all (atajo para uso local).
# En Render / produccion debe ser "production" y el esquema lo maneja Alembic.
ENVIRONMENT=development

# --- Panel de empleados (/empleados) ---
# Credenciales compartidas. Cambialas: no uses los valores por defecto en produccion.
EMPLOYEE_USERNAME=cambia_este_usuario
EMPLOYEE_PASSWORD=cambia_esta_contrasena

# --- Kill switch (antirrobo) ---
# Velocidad en km/h por debajo de la cual el vehiculo se considera detenido
# y se puede aplicar el comando de corte. Valor por defecto de la app: 2.0
KILL_SWITCH_SPEED_THRESHOLD_KMH=2.0
